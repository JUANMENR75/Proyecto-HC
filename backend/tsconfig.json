{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node", "express", "jsonwebtoken", "bcrypt"]
  },
  "include": [
    "src/**/*",
    "src/scripts/seed.ts"
  ],
  "exclude": ["node_modules"]
}
